    "item": [
        {
            "name": "Portfolio Management",
            "item": [
                {
                    "name": "Get Portfolio By ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "portfolios",
                                "{{portfolioId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Get All Portfolios for User",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/portfolios?userId={{userId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "portfolios"
                            ],
