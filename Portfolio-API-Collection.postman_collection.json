        {
            "name": "Portfolio Analytics",
            "item": [
                {
                    "name": "Get Advanced Analytics",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"coreIdentifiers\": {\n        \"userId\": \"{{userId}}\"\n    },\n    \"featureToggles\": {\n        \"includePerformance\": true,\n        \"includeRiskMetrics\": true,\n        \"includeSectorAllocation\": true\n    },\n    \"fromDate\": \"2023-01-01\",\n    \"toDate\": \"2023-12-31\",\n    \"timeFrame\": \"DAILY\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/analytics/portfolio/{{portfolioId}}/advanced",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "analytics",
                                "portfolio",
                                "{{portfolioId}}",
                                "advanced"
                            ]
                        }
                    }
                }
            ]
        },
